[Unit]
Description=Seer (Laravel) - fila de importações e relatórios
After=network.target

[Service]
User=matheus
WorkingDirectory=/home/matheus/InovaApps2026/app
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=2 --max-time=3600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
